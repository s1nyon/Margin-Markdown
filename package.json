{
  "name": "margin-markdown",
  "version": "0.1.1",
  "private": true,
  "description": "Markdown and LaTeX rendered margin comments for Zotero PDF annotations",
  "author": "s1nyon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s1nyon/Margin-Markdown.git"
  },
  "config": {
    "addonName": "Margin Markdown",
    "addonID": "margin-markdown@s1nyon",
    "addonRef": "marginmarkdown",
    "addonInstance": "MarginMarkdown",
    "prefsPrefix": "extensions.zotero.marginmarkdown"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test": "node scripts/prepare-renderer.mjs && vitest run",
    "stress": "node scripts/prepare-renderer.mjs && vitest run --config vitest.stress.config.ts",
    "typecheck": "node scripts/prepare-renderer.mjs && tsc --noEmit",
    "verify": "node scripts/verify-xpi.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "adm-zip": "^0.5.18",
    "happy-dom": "^18.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "zotero-plugin-scaffold": "^0.6.0",
    "zotero-types": "^3.1.9"
  },
  "engines": {
    "node": ">=22.8.0",
    "pnpm": ">=11.25.0"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "dompurify": "^3.4.16",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "markdown-it-texmath": "^1.0.0"
  }
}
